{
  "permissions": {
    "allow": [
      "WebFetch(domain:www.jiuyangongshe.com)",
      "Bash(node:*)",
      "Bash(tree:*)",
      "Bash(git init:*)",
      "Bash(git config:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh repo create:*)",
      "Bash(git remote:*)",
      "Bash(git push:*)",
      "Bash(git filter-branch:*)",
      "Bash(echo:*)",
      "Bash(npm install:*)",
      "Bash(yamllint:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "WebSearch",
      "WebFetch(domain:docs.coze.com)",
      "WebFetch(domain:www.npmjs.com)",
      "Bash(del:*)",
      "Bash(find:*)",
      "Bash(git checkout:*)",
      "Bash(ping:*)",
      "Bash(curl:*)",
      "Bash(set NODE_TLS_REJECT_UNAUTHORIZED=0:*)",
      "Bash(dir:*)",
      "Bash(cat:*)",
      "Bash(npm run local)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "context7"
  ],
  "plugins": [
    "./memory-plugin"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/memory-plugin/hooks/session-start.sh\"",
            "timeout": 12
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/memory-plugin/hooks/user-prompt-submit.sh\"",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/memory-plugin/hooks/stop.sh\"",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/memory-plugin/hooks/session-end.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
