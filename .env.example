# ===== 飞书推送（必需）=====
# 飞书群机器人 webhook（在飞书群设置-群机器人-自定义机器人中创建）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# ===== GLM API（可选）=====
# 不设置时，LLM 阶段走 agent-handoff 模式（由 ZCode 定时任务驱动）
# 设置后管线直调智谱 OpenAI 兼容接口
# GLM_API_KEY=your_glm_api_key
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL_SCORE=glm-4-flash
# GLM_MODEL_CLUSTER=glm-4-flash
# GLM_MODEL_WRITE=glm-4-flash
