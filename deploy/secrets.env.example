# 复制为 deploy/secrets.env、填入真实值，并【提交到私有仓库】——云端 Agent 每轮克隆后 cp 为 .env 使用。
# ⚠️ 此文件含密钥，只能存在于私有仓库；若仓库将来转公开，必须先清除全部历史。

# 飞书群机器人 webhook（必需）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# GLM API（必需，云端走直调模式，不再需要 agent handoff）
GLM_API_KEY=xxxxxxxx

# 可选：不填用管线默认（open.bigmodel.cn / glm-4-flash 档）
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL_SCORE=glm-4-flash
# GLM_MODEL_CLUSTER=glm-4-flash
# GLM_MODEL_WRITE=glm-4-flash
