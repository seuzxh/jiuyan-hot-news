{
  "name": "jyc-hot-news",
  "version": "2.0.0",
  "description": "韭研公社资讯聚合系统：采集 → 预筛 → LLM 打分 → 事件聚簇 → 热度 → 飞书推送/网站",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "crawl": "tsx scripts/crawl.ts",
    "prefilter": "tsx scripts/prefilter.ts",
    "score": "tsx scripts/score.ts",
    "detail": "tsx scripts/detail.ts",
    "cluster": "tsx scripts/cluster.ts",
    "write": "tsx scripts/write.ts",
    "theme": "tsx scripts/theme.ts",
    "push": "tsx scripts/push.ts",
    "ask": "tsx scripts/ask.ts",
    "web": "npm run dev -w @jyc/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json"
  },
  "keywords": [
    "aggregator",
    "jiuyangongshe",
    "feishu",
    "llm"
  ],
  "author": "seuzxh",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
